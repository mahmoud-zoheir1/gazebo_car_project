
<?xml version="1.0"?>
<sdf version="1.9">
  <model name="white_track_lines">
    <static>true</static>
    <link name="lines_link">

      <visual name="left_line">
        <geometry>
          <mesh>
            <uri>file:///home/mahmoud-zoheir/gazebo_car_project/white_line_left.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <visual name="right_line">
        <geometry>
          <mesh>
            <uri>file:///home/mahmoud-zoheir/gazebo_car_project/white_line_right.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
