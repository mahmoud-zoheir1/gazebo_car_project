
<?xml version="1.0"?>
<sdf version="1.9">

  <world name="car_world">

    <!-- PHYSICS -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- SUN -->
    <light type="directional" name="sun">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- GREEN GROUND -->
    <model name="ground_plane">
      <static>true</static>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>

          <material>
            <!-- Neutral concrete gray -->
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.52 0.52 0.52 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- GAZEBO CAR -->
    <include>
      <uri>file:///home/mahmoud-zoheir/gazebo_car_project/my_car.sdf</uri>
    </include>

    <!-- SMOOTH RACING ROAD -->
    <include>
      <uri>file:///home/mahmoud-zoheir/gazebo_car_project/road_mesh_model.sdf</uri>
    </include>

    <!-- BLUE / YELLOW RACING CONES -->
    <include>
      <uri>file:///home/mahmoud-zoheir/gazebo_car_project/track_cones.sdf</uri>
    </include>

    <!-- WHITE TRACK BOUNDARY LINES -->
    <include>
      <uri>file:///home/mahmoud-zoheir/gazebo_car_project/white_lines.sdf</uri>
    </include>
    
    <!-- REFERENCE CENTERLINE -->
    <include>
      <uri>file:///home/mahmoud-zoheir/gazebo_car_project/centerline.sdf</uri>
    </include>
    
  </world>

</sdf>
